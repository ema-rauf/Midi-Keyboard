	(pad "1" smd rect (at 0 0) (size 10 30) (layers "F.Cu" "F.Mask"))
	(pad "2" smd rect (at 11 0) (size 10 30) (layers "F.Cu" "F.Mask"))
	(pad "3" smd rect (at 22 0) (size 10 30) (layers "F.Cu" "F.Mask"))
